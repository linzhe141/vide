{
  "name": "@vide/main",
  "private": true,
  "version": "0.0.0-beta.12",
  "main": "./dist/electron/main/index.js",
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "dev": "node ./scripts/dev.mjs",
    "build": "pnpm --dir ../renderer build && vite build --mode production --config vite.main.config.ts && vite build --mode production --config vite.preload.config.ts",
    "package": "cross-env NODE_ENV=production electron-builder --config electron-builder.config.ts",
    "release": "cross-env NODE_ENV=production electron-builder --config electron-builder.config.ts --publish always",
    "rebuild:electron": "electron-rebuild",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts"
  },
  "exports": {
    "./ipcRenderer": "./src/ipc/api/ipcRenderer.ts"
  },
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/ws": "^8.18.1",
    "@vide/agent": "workspace:*",
    "@vide/ai": "workspace:*",
    "@vide/config": "workspace:*",
    "chokidar": "^5.0.0",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "electron": "41.3.0",
    "electron-builder": "^26.8.1",
    "electron-log": "^5.4.3",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.3",
    "isbinaryfile": "^6.0.0",
    "node-abi": "4.31.0",
    "openai": "^6.37.0",
    "vite": "^8.0.11"
  }
}
